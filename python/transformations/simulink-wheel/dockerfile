FROM containers.mathworks.com/matlab-runtime:r2024b

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates p11-kit \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && test -f /opt/matlabruntime/R2024b/sys/java/jre/glnxa64/jre/lib/security/cacerts \
    && trust extract --overwrite --format=java-cacerts --filter=ca-anchors \
        --purpose=server-auth /opt/matlabruntime/R2024b/sys/java/jre/glnxa64/jre/lib/security/cacerts \
    && rm -rf /var/lib/apt/lists/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
RUN /opt/venv/bin/python -c 'import os, shutil; import pip._vendor.certifi as certifi; source = "/etc/ssl/certs/ca-certificates.crt"; target = certifi.where(); (os.path.exists(target) and os.path.samefile(source, target)) or shutil.copyfile(source, target)' \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
        --cert /etc/ssl/certs/ca-certificates.crt \
        pip==26.2.2 certifi==2026.10.19

# quixmatlab finds the MATLAB Runtime through LD_LIBRARY_PATH.
ENV PATH="/opt/venv/bin:$PATH" \
    LD_LIBRARY_PATH=/opt/matlabruntime/R2024b/runtime/glnxa64 \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    PYTHONPATH="/app"

ARG MAINAPPPATH=.

WORKDIR /app

COPY "${MAINAPPPATH}/requirements.txt" "${MAINAPPPATH}/quixmatlab_r2024b-24.2-py3-none-any.whl" "${MAINAPPPATH}/"

# pip resolves the wheel path in requirements.txt against the working directory.
RUN cd "${MAINAPPPATH}" && pip install --no-cache-dir -r requirements.txt

COPY . .

WORKDIR "/app/${MAINAPPPATH}"

ENTRYPOINT ["python3", "main.py"]
