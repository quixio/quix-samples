FROM ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b AS uv-tools

FROM quixpublic.azurecr.io/devsessions-marimo:stable@sha256:b42b6baceaa82673b74175d83897b8543a0d9567761ff0951fbbaca92cd775d8

COPY --from=uv-tools /uv /uvx /bin/

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt

RUN python3 -c 'import os, shutil; import pip._vendor.certifi as certifi; source = "/etc/ssl/certs/ca-certificates.crt"; target = certifi.where(); (os.path.exists(target) and os.path.samefile(source, target)) or shutil.copyfile(source, target)' \
    && python3 -m pip install --no-cache-dir \
        --cert /etc/ssl/certs/ca-certificates.crt \
        pip==26.2.2 certifi==2026.10.19

# Copy your notebook
COPY main.py /app/main.py
COPY quix_blob.py /app/quix_blob.py
COPY icon.png /app/icon.gif

# Optional: Copy additional requirements
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt
