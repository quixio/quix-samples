# Use the official InfluxDB image from the Docker Hub
FROM influxdb:2.7.12@sha256:b8d940ca9376f85118260f5b6bd236b8a00b1749c3350c5578d4cde8e27f31f2

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the InfluxDB configuration file if needed
ADD influx-configs.toml /etc/influxdb2/influx-configs.toml
ENV INFLUXD_CONFIG_PATH=/etc/influxdb2/influx-configs.toml

# Define initial setup environment variables
ENV DOCKER_INFLUXDB_INIT_MODE setup
ENV DOCKER_INFLUXDB_INIT_USERNAME admin
ENV DOCKER_INFLUXDB_INIT_ORG quix

# Expose the necessary ports (8086 is the default port for InfluxDB)
EXPOSE 8086

# Define the default command to run when starting the container
COPY init.sh /init.sh
RUN chmod +x /init.sh
ENTRYPOINT ["/init.sh"]
