# Stage 1: build Go runtime binaries
FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS builder
ENV GOTOOLCHAIN=local
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/*
RUN git init /src \
    && git -C /src remote add origin https://github.com/quixio/tsbs-quix.git \
    && git -C /src fetch --depth 1 origin 77799146ea9b810825ea74696241ccd42cb24d4e \
    && git -C /src checkout --detach FETCH_HEAD \
    && test "$(git -C /src rev-parse HEAD)" = 77799146ea9b810825ea74696241ccd42cb24d4e
WORKDIR /src
RUN go build -mod=readonly -o bin/tsbs_generate_data ./cmd/tsbs_generate_data \
    && go build -mod=readonly -o bin/tsbs_load_kafka_quix ./cmd/tsbs_load_kafka_quix


# Stage 2: build runtime container
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# Install CA certs for HTTPS
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419~deb12u2 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/bin/tsbs_generate_data /app/bin/tsbs_generate_data
COPY --from=builder /src/bin/tsbs_load_kafka_quix /app/bin/tsbs_load_kafka_quix
COPY ./main.sh /app/main.sh
WORKDIR /app

RUN chmod +x main.sh bin/tsbs_generate_data bin/tsbs_load_kafka_quix

ENTRYPOINT ["./main.sh"]
