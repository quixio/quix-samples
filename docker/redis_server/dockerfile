# Use the official Redis image from the Docker Hub
FROM redis/redis-stack-server:7.4.0-v8

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the custom redis.conf file
COPY redis.conf /usr/local/etc/redis/redis.conf

# Expose the default Redis port
EXPOSE 6379

USER root

# redis-stack-server image doesn't include a redis user (unlike the standard redis image)
RUN groupadd -r redis && useradd -r -g redis redis

COPY init.sh /init.sh
RUN chmod +x /init.sh
ENTRYPOINT ["/init.sh"]
