FROM postgres:16.15@sha256:9e2cf6287f25c3151f4c9421ccce2b17f3e60061c111a29165e0d2cdd9ff0a97

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install wal2json plugin
RUN apt-get update && apt-get install -y postgresql-16-wal2json

# Set environment variables for PostgreSQL (will be overridden in K8s runtime if needed)
ENV PGDATA=/app/state/pgdata
ENV POSTGRES_USER=admin
ENV POSTGRES_DB=quix

EXPOSE 5432

# Define the default command to run when starting the container
USER root
COPY init.sh /init.sh
RUN chmod +x /init.sh
ENTRYPOINT ["/init.sh"]
