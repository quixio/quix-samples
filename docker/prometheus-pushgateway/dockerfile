FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS ca-trust
RUN dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20250419~deb12u2'

# Use the official Prometheus Pushgateway image as the base image
FROM prom/pushgateway:v1.11.2@sha256:c835998819105d84d484918908df132807c78c05f3e0e649df0c0479c6780d98

USER root
RUN mkdir -p /opt/quix-trust/certs
COPY --from=ca-trust /etc/ssl/certs/ca-certificates.crt /opt/quix-trust/ca-certificates.crt
RUN for bundle in \
        /etc/ssl/certs/ca-certificates.crt \
        /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/ca-bundle.pem \
        /etc/pki/tls/cacert.pem \
        /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
        /etc/ssl/cert.pem; do \
        if [ -e "$bundle" ] || [ -L "$bundle" ]; then \
            rm -f "$bundle" \
                && cp /opt/quix-trust/ca-certificates.crt "$bundle" || exit 1; \
        fi; \
    done
ENV SSL_CERT_FILE=/opt/quix-trust/ca-certificates.crt \
    SSL_CERT_DIR=/opt/quix-trust/certs
USER 65534

# Expose the default Pushgateway port
EXPOSE 9091

# Default command to run the Pushgateway
CMD ["--web.listen-address=:9091"]
