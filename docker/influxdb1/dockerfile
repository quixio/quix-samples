# Use the official InfluxDB image from the Docker Hub
FROM influxdb:1.12@sha256:b0d38932a1ace211782a030ace6d9aff2ad9cdd38f25ea13ff9d27f4a5845301

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && . /etc/os-release \
    && case "$ID:$VERSION_ID" in \
        debian:12) ca_minimum='20250419~deb12u2' ;; \
        debian:13) ca_minimum='20250419+deb13u1' ;; \
        ubuntu:22.04) ca_minimum='20260816ubuntu0.22.04.1' ;; \
        ubuntu:24.04) ca_minimum='20260816ubuntu0.24.04.1' ;; \
        *) echo "No validated CA package floor for $ID:$VERSION_ID" >&2; exit 1 ;; \
    esac \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$ca_minimum" \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
USER influxdb

ENV INFLUXD_CONFIG_PATH=/etc/influxdb/influx.conf

# Copy the InfluxDB configuration file if needed
ADD influx.conf "${INFLUXD_CONFIG_PATH}"

# Expose the necessary ports (8086 is the default port for InfluxDB)
EXPOSE 8086

# Define the default command to run when starting the container.
# Use COPY --chmod because influxdb:1.12 sets a non-root USER, so a
# subsequent RUN chmod would be denied (was permitted under 1.8).
COPY --chmod=0755 init.sh /init.sh
ENTRYPOINT ["/init.sh"]
